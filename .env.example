# Paper2Sim API Configuration

# LLM API Keys (fallback chain: Groq -> OpenRouter -> Gemini -> mock)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
GOOGLE_AI_STUDIO_API_KEY=""
GOOGLE_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""

# Pipeline storage (SQLite job store + artifacts, no Redis day one)
DATA_DIR="./data"
JOBS_DB=""

# Pipeline tuning
MAX_REPAIR_ATTEMPTS=3
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_NO_NET=""
SENTRY_DSN=""

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Cache
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT=60/minute
